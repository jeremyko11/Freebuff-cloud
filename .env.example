# Telegram 通知（必填才发通知；缺省只写库）
TG_BOT_TOKEN=
TG_CHAT_ID=

# ---- 聪明钱名单 ----
# 每个排行榜周期取 top N（DAY/WEEK/MONTH，逗号分隔）
SM_SEED_PER_PERIOD=30
# SM_SEED_CATEGORIES=OVERALL,POLITICS,SPORTS,CRYPTO
# 准入：胜率 ≥ 55%、已平仓 ≥ 10 笔、周期 PnL ≥ $500
SM_MIN_WIN_RATE=0.55
SM_MIN_CLOSED_TRADES=10
SM_MIN_PNL=500
# 名单上限（控 API 用量；DATA_API 限流 200/10s）
SM_MAX_WALLETS=50
# 手动追加观察地址（跳过准入，逗号分隔）
SM_EXTRA_ADDRESSES=
# 做市商剔除：1h 内 ≥ 20 笔且买卖均衡
SM_MM_WINDOW_SEC=3600
SM_MM_MIN_TRADES=20
# 名单刷新周期（小时）
SM_REFRESH_HOURS=24

# ---- 监控 ----
# 全名单轮询周期（秒）
MON_POLL_INTERVAL_SEC=300
# 单笔信号金额门槛（USDC）
MON_MIN_SIGNAL_USDC=200
# 拆单建仓：1h 窗口 ≥ 3 笔小额同向、累积 ≥ $1000
MON_SWEEP_WINDOW_SEC=3600
MON_SWEEP_MIN_TRADES=3
MON_SWEEP_MIN_TOTAL_USDC=1000
# 信号去重窗口（秒）
MON_DEDUP_WINDOW_SEC=3600
# 验证闭环（信号后 1h/24h 价格回填）
MON_VERIFY=1

# ---- 运行 ----
FB_DB_PATH=data/freebuff.db
FB_LOG_LEVEL=INFO
